MICROCMS_API_KEY=xxxx
OG_IMAGE_GEN_AUTH_TOKEN=xxx

# profile-as-a-service (プロフィール情報の単一ソース)
# 未設定なら fetch せず、src/libs/profile/fallback.ts の静的コピーで描画する。
# ブラウザからも読むため NEXT_PUBLIC_ が必要（ビルド時にインライン展開される）。
# 値は profile-as-a-service の ProfileSiteStack が出力する DistributionDomainName。
# NEXT_PUBLIC_PROFILE_BASE_URL=https://xxxxxxxx.cloudfront.net
# NEXT_PUBLIC_PROFILE_ID=hidetaka
# Optional: Google Analytics 4 Measurement ID (defaults to G-RV8PYHHYHN if not set)
# NEXT_PUBLIC_GA_ID=G-RV8PYHHYHN

# Optional: Enable Hatena Star feature on blog posts (defaults to false if not set)
# Set to "true" to enable Hatena Star on Japanese blog pages
NEXT_PUBLIC_ENABLE_HATENA_STAR=true

# Sentry Error Tracking
# Get your DSN from https://sentry.io/settings/[organization]/projects/[project]/keys/
# Browser-side DSN (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@sentry.io/your-project-id

# Server-side DSN for Cloudflare Workers (set in Cloudflare Pages environment variables)
SENTRY_DSN=https://your-public-key@sentry.io/your-project-id

# Sentry CLI configuration for source map uploads
# Get your auth token from https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-organization-slug
SENTRY_PROJECT=your-sentry-project-slug
