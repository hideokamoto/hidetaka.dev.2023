{
  "name": "hidetaka-dev-workers",
  // OpenNext が生成する worker を包み、cron 用の scheduled ハンドラを足したエントリ
  // (src/custom-worker.ts)。R2 キャッシュ掃除の詳細は docs/guides/r2-cache-janitor.md
  "main": "src/custom-worker.ts",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "services": [
    {
      "binding": "OG_IMAGE_GENERATOR",
      "service": "cf-ogp-image-gen-worker"
    },
    // Self-reference required by @opennextjs/cloudflare's Durable Object queue
    // (open-next.config.ts: queue: doQueue) to trigger ISR background
    // revalidation. Without it, DOQueueHandler throws "No service binding for
    // cache revalidation worker" and every stale-page revalidation silently
    // fails (observed: ~9.2k such errors/week in Workers Logs).
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hidetaka-dev-workers"
    }
  ],
  // R2 bucket for incremental cache and ISR
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "hidetaka-dev-cache"
    }
  ],
  // Durable Objects for ISR queue handling
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  // Durable Objects migrations
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["DOQueueHandler"]
    }
  ],
  // R2 incremental cache に残る古いビルドのキャッシュを掃除する cron（毎時 17 分）。
  // 実削除に切り替えるまでは JANITOR_DRY_RUN="true" のまま、削除対象をログに出すだけ。
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // このファイルが設定の正。keep_vars が既定（false）のため、ダッシュボードでの編集は
  // 次回デプロイで消える。実削除への切り替えは "false" に変えた PR で行う。
  "vars": {
    "JANITOR_DRY_RUN": "true",
    "JANITOR_KEEP_DAYS": "14"
  },
  // Version metadata binding for Sentry release tracking
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
